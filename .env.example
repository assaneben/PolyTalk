# Documentation seulement. npm run setup génère .env avec de nouveaux secrets.
HOST=127.0.0.1
PORT=3210
PUBLIC_ORIGIN=http://localhost:3210
MATRIX_UPSTREAM=http://127.0.0.1:8008
MATRIX_SERVER_NAME=localhost
POLYTALK_EDITION=intranet
DATA_DIR=./data
# Générés localement ; ne pas utiliser ces marqueurs comme secrets.
POLICY_SECRET=GENERATED_BY_SETUP
REGISTRATION_SECRET=GENERATED_BY_SETUP
POSTGRES_PASSWORD=GENERATED_BY_SETUP
MATRIX_JWT_SECRET=GENERATED_BY_SETUP
# Vide : inscription ouverte. Une valeur active la restriction d'inscription.
SIGNUP_CODE=
# Liste séparée par virgules de pairs proxy de confiance et d'adresses opérateurs.
TRUSTED_PROXY_PEERS=
POLYTALK_APPROVERS=
# ID public Reown ; les wallets restent désactivés sans configuration valable.
WALLETCONNECT_PROJECT_ID=
# Adaptateurs : environnement privé distinct, non chargé implicitement depuis ce fichier.
POLYTALK_ORIGIN=http://localhost:3210
POLYTALK_AGENT_STORE=
POLYTALK_AGENT_PASSWORD=
POLYTALK_AGENT_BINARY=
POLYTALK_A2A_PORT=3211
POLYTALK_A2A_ROOM=
POLYTALK_A2A_TOKEN=
POLYTALK_GRAPHIFY_BINARY=
POLYTALK_GRAPHIFY_GRAPH=
POLYTALK_GRAPHIFY_PYTHON=0
POLYTALK_XERJ_BINARY=
XERJ_AUTH=
XERJ_DISABLE_FEEDBACK=true
# Fixtures uniquement ; ne pas rediriger les tests vers des comptes réels.

# Trace de diagnostic native, désactivée ; ne doit pas consigner le contenu des messages.
POLYTALK_AGENT_TRACE=0
